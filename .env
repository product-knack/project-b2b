# SDK 56 replaced globalThis.fetch with expo/fetch. Six upload paths read local
# file:// picker URIs via fetch(uri).arrayBuffer() (chat media, avatars, doctor
# files, QHP PDFs, Tech Desk attachments). expo/fetch does not document file://
# support, so keep React Native fetch as the global until those are ported to
# expo-file-system's File API. Official flag, see docs/versions/v57/sdk/expo.
EXPO_PUBLIC_USE_RN_FETCH=1
